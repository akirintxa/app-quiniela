# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Solo servidor (admin / reparto de puntos). NUNCA commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Emails que pueden entrar a /admin (separados por coma)
ADMIN_EMAIL=tu@email.com

# Producción: https://tu-app.vercel.app | Local: http://localhost:3000
# Usado en enlaces /join/{código} y QR de invitación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Correos de auth (registro, confirmación, reset) ---
# El envío NO va por esta app: configura SMTP en Supabase Dashboard.
# Recomendado: Resend (https://resend.com) → Project Settings → Auth → SMTP
#   Host: smtp.resend.com | User: resend | Password: tu API key de Resend
# Verifica dominio en Resend y añade Site URL + redirect URLs en Supabase Auth.
# Opcional si más adelante envías correos desde la app (no auth):
# RESEND_API_KEY=re_...

# Secreto para /api/cron/* (Bearer en cron-job.org)
CRON_SECRET=genera-un-secreto-largo-aleatorio

# Sincronización automática de marcadores desde worldcup26.ir (true/false)
AUTO_SCORE_SYNC=false

# Opcional: URL alternativa del proveedor de marcadores
# WORLD_CUP26_API_URL=https://worldcup26.ir/get/games
